{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tinystudio-io-public",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-29",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    { "pattern": "tinystudio.io/*", "zone_name": "tinystudio.io" },
    { "pattern": "www.tinystudio.io/*", "zone_name": "tinystudio.io" },
    { "pattern": "app.tinystudio.io/*", "zone_name": "tinystudio.io" },
    { "pattern": "api.tinystudio.io/*", "zone_name": "tinystudio.io" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["17 6 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tinystudio_email_signups",
      "database_id": "40e09689-b092-41af-816f-1b0a58cf7021",
      "preview_database_id": "dd76b0bd-dbd5-4fb9-bf86-aa682275a3df"
    }
  ],
  "r2_buckets": [{ "binding": "RECORDS", "bucket_name": "tinystudio-records" }],
  "ratelimits": [
    { "name": "APPRAISAL_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "ai": {
    "binding": "AI"
  },
  "build": {
    "command": "node build-fonts.mjs"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/*"]
  },
  "previews": {}
}
